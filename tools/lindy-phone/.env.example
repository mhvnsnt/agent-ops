# Copy to .env (or export in the environment). NEVER commit a filled .env.
# The owner's real number lives ONLY here / in the secret store — never in
# committed code, docs, or test fixtures.

# The owner's mobile number in E.164. This is the number every agent texts,
# and the ONLY inbound sender the gateway will answer.
OWNER_NUMBER=+1OWNER_NUMBER

# Provider: mock | telnyx | twilio
# mock = sms-sdk memory() adapter: no account, no network, sends are recorded.
SMS_PROVIDER=mock

# Agent registry file (see config/agents.example.json).
AGENTS_CONFIG=config/agents.json

# Port for the webhook server.
PORT=8787

# Shared secret required on the agent-initiated POST /send endpoint.
GATEWAY_TOKEN=change-me

# --- Live provider credentials (only when SMS_PROVIDER is not mock) ---
# Telnyx (recommended route — see SETUP-LIVE.md)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
# Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public base URL of this server, so provider webhook signatures can be
# verified against the full public URL (e.g. https://gateway.example.com).
PUBLIC_BASE_URL=
